{
  "manifest_version": 3,
  "name": "Studotools",
  "version": "1.2",
  "permissions": ["cookies"],
  "host_permissions": [
    "*://*.studeersnel.nl/nl/document/*/*",
    "*://*.studocu.com/en/document/*/*",
    "*://*.studocu.id/id/document/*/*",
    "*://*.studocu.vn/vn/document/*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "js": ["download.js"],
      "matches": [
        "*://*.studeersnel.nl/nl/document/*/*",
        "*://*.studocu.com/en/document/*/*",
        "*://*.studocu.id/id/document/*/*",
        "*://*.studocu.vn/vn/document/*/*",
        "*://*.scribd.com/document/*/*",
        "*://*.scribd.com/doc/*/*"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
